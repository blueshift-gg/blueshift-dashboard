{
  "name": "blueshift-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "previews.learn.blueshift.gg",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ],
  "previews": {},
  "preview_urls": false
}
