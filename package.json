{
  "name": "blueshift-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-esbuild-wasm": "node ./scripts/sync-esbuild-wasm.mjs",
    "postinstall": "pnpm run sync-esbuild-wasm",
    "predev": "pnpm run sync-esbuild-wasm",
    "prebuild": "pnpm run sync-esbuild-wasm",
    "build": "NEXT_PUBLIC_COMMIT_HASH=${WORKERS_CI_COMMIT_SHA:-$(git rev-parse HEAD)} next build",
    "build:cf": "bash ./scripts/ci/build.sh",
    "dev": "next dev",
    "start": "next start",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview --config wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "precompile-mdx": "ts-node -r tsconfig-paths/register -P ./tsconfig.scripts.json ./scripts/precompile-mdx.ts",
    "generate-banners": "NEXT_PUBLIC_RELEASED_COURSES='*' NEXT_PUBLIC_RELEASED_CHALLENGES='*' ts-node -r tsconfig-paths/register -P ./tsconfig.scripts.json ./scripts/generate-banners.ts",
    "format:check": "oxfmt --check .",
    "deploy:cf": "pnpm build:cf && bash scripts/ci/deploy.sh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@anchor-lang/core": "^0.32.1",
    "@blueshift-gg/faucet-react": "^0.2.2",
    "@blueshift-gg/ui-components": "^0.1.70",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.4.3",
    "@opennextjs/cloudflare": "1.20.15",
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.5.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-adapter-base": "^0.9.26",
    "@solana/wallet-adapter-phantom": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.38",
    "@solana/wallet-adapter-react-ui": "^0.9.38",
    "@solana/wallet-adapter-solflare": "^0.6.31",
    "@solana/web3.js": "^1.98.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.83.0",
    "bs58": "^6.0.0",
    "classnames": "^2.5.1",
    "dat.gui": "^0.7.9",
    "esbuild-wasm": "^0.27.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "jose": "^6.1.2",
    "monaco-editor": "^0.57.0",
    "motion": "^12.6.3",
    "motion-plus": "^1.5.1",
    "next": "16.4.3",
    "next-intl": "^4.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "sonner": "^2.0.7",
    "three": "^0.181.1",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@shikijs/core": "^3.15.0",
    "@shikijs/engine-oniguruma": "^3.15.0",
    "@shikijs/langs-precompiled": "^3.15.0",
    "@shikijs/types": "^3.15.0",
    "@tailwindcss/postcss": "^4",
    "@types/dat.gui": "^0.7.13",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.176.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "safe-mdx": "^1.3.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
