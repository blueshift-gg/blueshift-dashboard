# ====================================================================================
# Gemini Translation Configuration
# ====================================================================================
# Gemini API Key (required for translation)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Target language for translation (default: ko)
# Supported: ko, zh-CN, zh-HK, fr, uk, vi, id, de
TARGET_LANGUAGE=ko
